@JaReclamouHoje.Api_HostAddress = http://localhost:5001

### Register a new user
# @name registerRequest
POST {{JaReclamouHoje.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "New Reviewer",
  "email": "reviewer@example.com",
  "password": "123456"
}

###

### Login as the seeded admin user
# @name loginRequest
POST {{JaReclamouHoje.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "diedona@gmail.com",
  "password": "123123"
}

###

@authToken = {{loginRequest.response.body.token}}

### List complaints (with Bearer token)
GET {{JaReclamouHoje.Api_HostAddress}}/api/complaints
Accept: application/json
Authorization: Bearer {{authToken}}

###

### Create complaint (with Bearer token)
# @name createRequest
POST {{JaReclamouHoje.Api_HostAddress}}/api/complaints
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Elevator out of order",
  "description": "The east building elevator has been broken for two weeks."
}

###

### List complaints (no token -> 401)
GET {{JaReclamouHoje.Api_HostAddress}}/api/complaints
Accept: application/json

###

### Create complaint (no token -> 401)
POST {{JaReclamouHoje.Api_HostAddress}}/api/complaints
Content-Type: application/json

{
  "title": "T",
  "description": "This request should be rejected without a token."
}

###

### Get complaint by id (with Bearer token)
GET {{JaReclamouHoje.Api_HostAddress}}/api/complaints/00000000-0000-0000-0000-000000000000
Accept: application/json
Authorization: Bearer {{authToken}}